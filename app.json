{
  "expo": {
    "name": "Ture_iot_app_fixed",
    "slug": "Ture_iot_app_fixed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tureiotappfixed",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Middle ต้องการเข้าถึงตำแหน่งของคุณเพื่อระบุตำแหน่งเมื่อเกิดเหตุฉุกเฉิน",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Middle ต้องการเข้าถึงตำแหน่งของคุณเพื่อระบุตำแหน่งเมื่อเกิดเหตุฉุกเฉิน",
        "NSBluetoothAlwaysUsageDescription": "Middle ต้องการเชื่อมต่อกับอุปกรณ์ใกล้เคียงเพื่อตรวจจับการล้ม",
        "NSBluetoothPeripheralUsageDescription": "Middle ต้องการเชื่อมต่อกับอุปกรณ์ใกล้เคียงเพื่อตรวจจับการล้ม",
        "NSCameraUsageDescription": "Middle ต้องการเข้าถึงกล้องเพื่อสแกน QR Code สำหรับเข้าร่วมบ้าน",
        "NSPhotoLibraryUsageDescription": "Middle ต้องการเข้าถึงรูปภาพเพื่อเลือกรูปที่มี QR Code สำหรับเข้าร่วมบ้าน"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Ture_iot_app_fixed"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Middle ต้องการเข้าถึงกล้องเพื่อสแกน QR Code สำหรับเข้าร่วมบ้าน"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Middle ต้องการเข้าถึงรูปภาพเพื่อเลือกรูปที่มี QR Code สำหรับเข้าร่วมบ้าน"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF3055",
          "defaultChannel": "fall_alert"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e7ee3cf0-1a3b-43a7-b0fc-207a7c8947a4"
      }
    },
    "owner": "peerawoot.nutk"
  }
}
