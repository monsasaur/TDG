# ค่าตั้งของแอปมือถือ (Expo) — คัดลอกเป็น .env.local แล้วแก้ (.env.local ไม่ขึ้น git)
# Expo อ่านไฟล์นี้ตอนเปิด `npm start` — แก้แล้วต้องปิดเปิด Expo ใหม่ (ล้าง cache: npx expo start -c)
# ค่าที่ขึ้นต้น EXPO_PUBLIC_ ถูกฝังในแอป/เว็บ ใครก็อ่านได้ — ห้ามใส่ความลับ

# ── Express API ──
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:3000   # IP เครื่องที่รัน Express (มือถือจริง) · ไม่ตั้ง = 10.0.2.2:3000
# ⚠️ บังคับ — ไม่ตั้งแล้ว `npm start` / build หยุดทันที (เดิมถอยไปใช้คีย์ในรีโปแบบเงียบ ๆ)
EXPO_PUBLIC_API_KEY=                                  # ค่าเดียวกับ APP_API_KEY ใน express_api/.env (ไม่ได้ตั้ง APP_API_KEY = ค่าของ API_KEY)

# ── Supabase ──
# ไม่ตั้งทั้งคู่ = ฐานจริงของทีม · ฐานทดสอบ: ตั้งทั้งคู่จากโปรเจกต์เดียวกัน (Dashboard → Settings → API)
# ต้องเป็น anon / publishable key เท่านั้น — ใส่ service_role แล้ว app.config.js จะหยุดให้
# EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
