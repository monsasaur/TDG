PORT=3000

# ---------- API keys แยกตามผู้เรียก ----------
# scope ไหนไม่ได้ตั้งคีย์เฉพาะ จะถอยไปใช้ API_KEY — ระบบเดิมจึงไม่พัง
# แต่ production ควรตั้งให้ครบทั้ง 3 ตัว แล้วเลิกใช้ API_KEY
API_KEY=your_api_key_here      # fallback ของทุก scope (ของเดิม)

DEVICE_API_KEY=                # ESP32 → POST /predict เท่านั้น
APP_API_KEY=                   # แอปมือถือ → /events, /alert/ack, /push
                               #   ค่านี้คือตัวที่ฝังใน APK ผ่าน EXPO_PUBLIC_API_KEY
DEMO_API_KEY=                  # ปุ่มสาธิต → /demo/fire, /alert/test
                               #   ห้ามใส่ในแอป ไม่งั้นคนแกะ APK สั่งโทรออกได้

ML_SERVICE_URL=http://localhost:8000

# Mock โมเดลช่วงที่โมเดลจริงยังไม่เสร็จ
# USE_MOCK_ML=true → ข้าม ML service ใช้ mock แทน
# MOCK_IS_FALL=true → mock บอกว่าล้มทุกครั้ง (ทดสอบ flow ack/escalate)
# MOCK_IS_FALL=false → mock บอกว่าไม่ล้ม
USE_MOCK_ML=true
MOCK_IS_FALL=true

# Binary + Acknowledge flow
ACK_TIMEOUT_SECONDS=10    # รอ caregiver กดรับทราบในแอปกี่วินาที ก่อน escalate
COOLDOWN_SECONDS=300      # ไม่สร้าง alert ซ้ำของ device เดียวกันภายใน 5 นาที

# Twilio mode: fake = log สวยๆบน terminal (สำหรับ demo/dev) | real = ยิงจริง
TWILIO_MODE=fake
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE=+1234567890
ALERT_PHONES=+66812345678,+66898765432

# ---------- Admin Client (TDG_BA.pdf) ----------

# SEC-01 — admin ใช้ token ของตัวเอง ไม่ใช้ x-api-key ร่วมกับ ESP32/แอปมือถือ
# สร้าง hash ด้วย: node scripts/hash_admin_password.js '<รหัสผ่าน>'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$<salt>$<hash>

ADMIN_SESSION_HOURS=8          # SEC-04 — เซสชันหมดอายุเมื่อไม่ได้ใช้งาน
ADMIN_MAX_LOGIN_ATTEMPTS=5     # SEC-08 — จำกัดจำนวนครั้งที่ล็อกอินผิด (ต่อ 15 นาที)

# origin ของเว็บ admin ที่อนุญาตให้เรียก API ข้าม origin
# ใส่ "*" ได้เฉพาะตอน dev เท่านั้น
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# BR-02 / OI-01 — ไม่ได้รับข้อมูลเกินกี่นาทีถือว่า offline
# ค่านี้ยังเป็นค่าชั่วคราว ต้องวัดจริงว่า ESP32 ส่งข้อมูลถี่แค่ไหนในสภาพใช้งานจริงก่อน
DEVICE_OFFLINE_AFTER_MINUTES=15

ADMIN_TZ_OFFSET_HOURS=7        # NFR-08 — เวลาไทย
ADMIN_MAX_SCAN=5000            # NFR-03 — เพดานจำนวนแถวที่ดึงมาคำนวณต่อครั้ง

# ---------- Escalation recovery ----------
# timer อยู่ใน memory — restart แล้วหาย จึงสร้างใหม่จาก DB ตอน boot และเช็คซ้ำเป็นระยะ
ESCALATION_SWEEP_SECONDS=60              # เช็คเหตุการณ์ค้างทุกกี่วินาที
ESCALATION_RECOVERY_LOOKBACK_HOURS=24    # ตอน boot ย้อนไปหาเหตุการณ์ค้างไกลแค่ไหน
ESCALATION_MAX_AGE_SECONDS=3600          # เลยกำหนดเกินนี้ = สายไปแล้ว ไม่โทร แต่ปิดสถานะไว้

# ---------- API docs ----------
# Swagger UI ที่ /docs และ spec ดิบที่ /openapi.json
# ตั้ง false ถ้าไม่อยากเปิดเผยรายการ endpoint บน production
ENABLE_API_DOCS=true
