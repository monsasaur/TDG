PORT=3000
API_KEY=your_api_key_here

ML_SERVICE_URL=http://localhost:8000

# Mock โมเดลช่วงที่โมเดลจริงยังไม่เสร็จ
# USE_MOCK_ML=true → ข้าม ML service ใช้ mock แทน
# MOCK_IS_FALL=true → mock บอกว่าล้มทุกครั้ง (ทดสอบ flow ack/escalate)
# MOCK_IS_FALL=false → mock บอกว่าไม่ล้ม
USE_MOCK_ML=true
MOCK_IS_FALL=true

# Binary + Acknowledge flow
ACK_TIMEOUT_SECONDS=10    # รอ caregiver กดรับทราบในแอปกี่วินาที ก่อน escalate
COOLDOWN_SECONDS=300      # ไม่สร้าง alert ซ้ำของ device เดียวกันภายใน 5 นาที

# Twilio mode: fake = log สวยๆบน terminal (สำหรับ demo/dev) | real = ยิงจริง
TWILIO_MODE=fake
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE=+1234567890
ALERT_PHONES=+66812345678,+66898765432
