# ค่าที่จำเป็นสำหรับโหมด production (BLE provisioning)
# ใช้โดยลบ sdkconfig เดิมทิ้งแล้วรัน idf.py reconfigure หรือตั้งเองใน menuconfig
#
# ⚠️ ค่าเหล่านี้ไม่จำเป็นสำหรับโหมดเก็บข้อมูล — ถ้ายังเก็บ dataset อยู่ ไม่ต้องแตะ

# --- serial baudrate ต้องตรงกับ csi_collector_serial.py ---
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600

# --- flash + partition ---
# firmware เดิม 924 KB บน partition 1MB เหลือแค่ 123 KB — เพิ่ม BLE แล้วไม่พอ
# ต้องใช้ partitions.csv ที่ให้ app 2MB และ flash 4MB
# เช็คขนาด flash จริงก่อน: esptool.py flash_id
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Bluetooth (เดิมปิดอยู่) ---
# ใช้ NimBLE ไม่ใช่ Bluedroid เพราะกิน flash/RAM น้อยกว่ามาก
# และเราต้องการแค่ BLE ไม่ต้องการ Bluetooth Classic
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# --- WiFi provisioning ---
CONFIG_ESP_WIFI_NVS_ENABLED=y
