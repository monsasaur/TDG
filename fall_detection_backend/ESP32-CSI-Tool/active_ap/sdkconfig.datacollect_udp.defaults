# ค่าสำหรับ "โหมดเก็บข้อมูล ผ่าน UDP" — AP อย่างเดียว ช่องคงที่ ส่ง CSI ออก WiFi UDP
#
# วิธีใช้
#   rm sdkconfig
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.datacollect_udp.defaults" reconfigure
#   idf.py build && idf.py -p /dev/cu.usbserial-XXXX flash
#
# ไฟล์นี้สร้างขึ้น 2026-09-29 เพราะก่อนหน้านี้ค่าตั้งโหมดเก็บข้อมูลมีอยู่แค่ในไฟล์
# sdkconfig บนเครื่องเดียว ซึ่ง git ไม่ได้ติดตาม — ถ้าเครื่องพังคือตั้งใหม่เองทั้งหมด
# ค่าทุกตัวคัดมาจาก sdkconfig ที่ใช้เก็บ dataset จริง (ตรวจเทียบแล้ว)
#
# โหมด production (BLE provisioning) ใช้ sdkconfig.defaults แทน

# --- serial baudrate ---
# โหมด UDP ไม่ได้ส่ง CSI ออก serial แล้ว แต่คงค่านี้ไว้ให้ boot log อ่านง่ายด้วยสคริปต์เดิม
# ⚠️ ต้องมี _CUSTOM=y ก่อน ไม่งั้น BAUDRATE ไม่มีผล ถูกบังคับเป็น 115200 แบบเงียบ ๆ
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600

# --- CSI ---
# ⚠️ ขาดบรรทัดนี้ = esp_wifi_set_csi(1) คืน ESP_FAIL แล้ว abort() → reboot วนไม่จบ
#    คนละตัวกับ CONFIG_SHOULD_COLLECT_CSI ซึ่งเป็นออปชันของโปรเจกต์เราเอง
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_SHOULD_COLLECT_CSI=y
CONFIG_SHOULD_COLLECT_ONLY_LLTF=y
# ส่ง CSI ออก UDP แทนสาย USB — บอร์ดไม่ต้องต่อคอม แค่ต้องมีไฟ
CONFIG_SEND_CSI_TO_UDP=y
CONFIG_CSI_UDP_TARGET_IP="192.168.4.255"
# ส่งเฉพาะ CSI จาก ESP32 #2 — #1 ส่ง UDP ได้จำกัด เฟรมจากคอม/มือถือจะแย่งคิวจน CSI ของ #2 หลุด
# เปลี่ยนบอร์ด #2 = ต้องแก้ค่านี้ (ดู MAC ด้วย esptool.py read_mac)
CONFIG_CSI_UDP_SOURCE_MAC="1c:c3:ab:b9:78:cc"
# ปิดการส่งออก serial เพื่อไม่ให้ UART คอขวด (boot log ยังออก serial ปกติ)
# CONFIG_SEND_CSI_TO_SERIAL is not set
# CONFIG_SEND_CSI_TO_SD is not set

# --- AP ที่ ESP32 #2 เกาะเพื่อสร้าง packet ให้วัด CSI ---
# ช่อง 6 คงที่ — จำเป็นเพื่อให้ข้อมูลทุก session เทียบกันได้
CONFIG_WIFI_CHANNEL=6
CONFIG_ESP_WIFI_SSID="myssid"
CONFIG_ESP_WIFI_PASSWORD="mypassword"

# --- ปิด BLE provisioning ---
# ค่าเริ่มต้นของ Kconfig เป็น n อยู่แล้ว เขียนไว้ให้ชัดกันพลาด
# CONFIG_ENABLE_BLE_PROVISIONING is not set

# --- ปิด Bluetooth ---
# โหมดนี้ไม่ใช้ BT เลย และถ้าคอมไพล์ไว้แต่ไม่ init จะกิน RAM ที่ CSI ต้องใช้
CONFIG_BT_ENABLED=n

# --- flash + partition ---
# บอร์ดที่ใช้ยืนยันแล้วว่ามี flash 4MB (esptool.py flash_id · ESP32-D0WD-V3)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ─────────────────────────────────────────────────────────────
# ⚠️ ข้อแลกเปลี่ยนของโหมด UDP ที่ต้องรู้ก่อนเก็บข้อมูล
#
# แมคต้องเกาะ WiFi "myssid" ที่ ESP32 ปล่อย เพื่อรับ UDP broadcast
#   1. แมคจะเสียการเชื่อมต่ออินเทอร์เน็ตตลอดที่เก็บข้อมูล
#   2. แมคที่เกาะ AP กลายเป็นแหล่งสัญญาณเพิ่มบนช่อง 6 เดียวกับที่วัด CSI
#      → วางให้ห่างจากบริเวณที่ทำท่า และ **ห้ามขยับตลอด session**
#   3. ESP32 #1 ยังต้องมีไฟจาก USB adapter (ไม่ต้องเป็นคอม)
#
# ที่ได้คือไม่ต้องมีสายยาวถึงแมค ไม่ใช่ไม่ต้องมีแมค
#
# ฝั่ง Python ใช้สคริปต์ตัวเดิมที่มีโหมด session สลับคลาส:
#   CSI_TRANSPORT=udp python data_collection/csi_collector_serial.py
# ห้ามใช้ csi_collector.py (ตัวเก่า 22 เม.ย.) — ไม่มีโหมด session สลับคลาส
# ─────────────────────────────────────────────────────────────
